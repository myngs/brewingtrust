# MongoDB
MONGO_URI=mongodb://localhost:27017/trustbrew

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# Email (Gmail / Nodemailer)
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Blockchain (Ganache / Hardhat local node)
# Start Ganache example:
#   npx ganache --chain.chainId 1337 --accounts 10 --host 127.0.0.1 --port 7545 --deterministic
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545

# PRIVATE_KEY should be the account private key used by the server to sign txs.
# You may include or omit the 0x prefix.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# CONTRACT_ADDRESS must be the deployed Attendance contract address (NOT a wallet address).
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
